# File .env di Jarvis (sta in ~/jarvis/.env). Non condividerlo mai.
ANTHROPIC_API_KEY=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
NOME_UTENTE=Jonatan

# Facoltativi: per vedere il costo in euro nella scheda Uso, scrivi i prezzi del tuo fornitore
#PREZZO_INPUT_PER_MILIONE=
#PREZZO_OUTPUT_PER_MILIONE=
#PREZZO_PER_RICERCA=
#PREZZO_VALUTA=€

# Produttività: per pubblicare le demo con un link direttamente da Jarvis (facoltativo)
# Netlify > User settings > Applications > Personal access tokens
#NETLIFY_TOKEN=

# Cartelle Drive dei progetti: chi ha il link entra senza chiedere. reader = vede e scarica (predefinito),
# commenter = commenta, writer = può anche caricare e modificare file
#DRIVE_LINK_RUOLO=reader

# Lead da Maps: chiave della Google Places API (New), facoltativa. Senza chiave si usa OpenStreetMap (gratis)
#GOOGLE_PLACES_API_KEY=

# --- Pagina iPhone del custode (Tailscale). Senza PIN l'accesso remoto è spento. Almeno 4 cifre.
#JARVIS_PIN=

# --- AI di riserva (Jarvis 3.7, guida in LEGGIMI-AI.md): tutte facoltative
# GEMINI_API_KEY=
# GEMINI_MODELLO=gemini-3.6-flash
# OPENAI_API_KEY=
# OPENAI_MODELLO=gpt-6-luna
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODELLO=llama3.2
# OPENROUTER_API_KEY=
# OPENROUTER_MODELLO=openrouter/auto
# AI_ORDINE=gemini,openai,ollama,openrouter
# TETTO_SPESA_MESE=40
